# ─────────────────────────────────────────────────────────────
# Vocalyze — environment variables
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini (required) ─────────────────────────────────
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the models used.
# GEMINI_MODEL handles transcription, analysis, insight reports and Q&A.
GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL creates the vectors used by "Ask your feedback" (stored as 768 dims).
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── Supabase (required) ──────────────────────────────────────
# Dashboard → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY — never expose.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Only for scripts (npm run db / migrations) and Auth config via the Management API.
# Dashboard → Account → Access Tokens (sbp_...). Never used by the running app.
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=your-project-ref

# ── Email (Resend) ───────────────────────────────────────────
# https://resend.com/api-keys — used for critical-feedback alerts, employee
# confirmations, HR responses and emailed insight reports.
RESEND_API_KEY=re_your-resend-key
# Until you verify a domain in Resend, keep onboarding@resend.dev and alerts can
# only be delivered to the Resend account owner's address.
EMAIL_FROM="Vocalyze <onboarding@resend.dev>"
# Who receives critical alerts and emailed insight reports.
HR_ALERT_EMAIL=hr@yourcompany.com

# ── Google sign-in for HR (configured in Supabase Auth) ──────
# Google Cloud → Credentials → OAuth client (Web). Authorized redirect URI:
#   https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── HR admin bootstrap (used by `npm run create-hr`) ─────────
# Creates this Supabase Auth user and grants HR access.
HR_ADMIN_EMAIL=hr@yourcompany.com
HR_ADMIN_PASSWORD=change-me-strong-password
HR_ADMIN_NAME=Priya Sharma

# ── App ──────────────────────────────────────────────────────
# Public base URL (used in tracking links). Use your Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Organisation name shown on the employee feedback form.
NEXT_PUBLIC_ORG_NAME=Acme Corp

# HMAC secret linking anonymous activity to employee accounts (server only).
# Generate with: openssl rand -hex 32
ANON_LINK_SECRET=generate-a-long-random-secret

# Demo employee account for the portal (npm run create-employee)
DEMO_EMPLOYEE_EMAIL=employee@vocalyze.demo
DEMO_EMPLOYEE_PASSWORD=change-me
